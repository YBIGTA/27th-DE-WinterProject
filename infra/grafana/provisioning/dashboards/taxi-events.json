{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Total Events",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "PDEE91DDB90597936"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "PDEE91DDB90597936"
          },
          "queryType": "sql",
          "rawSql": "SELECT count() as total FROM default.taxi_events WHERE $__timeFilter(ts)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Avg Trip Duration",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "PDEE91DDB90597936"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "PDEE91DDB90597936"
          },
          "queryType": "sql",
          "rawSql": "SELECT round(avg(duration), 1) as avg_minutes FROM (SELECT trip_id, dateDiff('minute', minIf(ts, event='PICKUP'), maxIf(ts, event='DROPOFF')) as duration FROM default.taxi_events WHERE $__timeFilter(ts) GROUP BY trip_id HAVING duration > 0 AND duration < 180)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "unit": "min"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Unique Trips",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "PDEE91DDB90597936"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "PDEE91DDB90597936"
          },
          "queryType": "sql",
          "rawSql": "SELECT uniq(trip_id) as unique_trips FROM default.taxi_events WHERE $__timeFilter(ts)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Events Over Time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "PDEE91DDB90597936"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "PDEE91DDB90597936"
          },
          "queryType": "sql",
          "rawSql": "SELECT toStartOfMinute(ts) as time, event, count() as events FROM default.taxi_events WHERE $__timeFilter(ts) GROUP BY time, event ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Top 10 Zones by Demand",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "PDEE91DDB90597936"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "PDEE91DDB90597936"
          },
          "queryType": "sql",
          "rawSql": "SELECT toString(zone_id) as zone, count() as demand FROM default.taxi_events WHERE event = 'PICKUP' AND $__timeFilter(ts) GROUP BY zone_id ORDER BY demand DESC LIMIT 10",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Events Per Minute (Real-time)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "PDEE91DDB90597936"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "PDEE91DDB90597936"
          },
          "queryType": "sql",
          "rawSql": "SELECT toStartOfMinute(ts) as time, count() as events_per_min FROM default.taxi_events WHERE $__timeFilter(ts) GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 50
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Hourly Event Distribution",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "PDEE91DDB90597936"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "PDEE91DDB90597936"
          },
          "queryType": "sql",
          "rawSql": "SELECT toString(toHour(ts)) as hour, countIf(event = 'PICKUP') as PICKUP, countIf(event = 'DROPOFF') as DROPOFF, countIf(event = 'IN_TRANSIT') as IN_TRANSIT FROM default.taxi_events WHERE $__timeFilter(ts) GROUP BY hour ORDER BY toHour(ts)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Pickup Demand by Zone (Last 24h, % Share)",
      "type": "geomap",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "PDEE91DDB90597936"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "PDEE91DDB90597936"
          },
          "queryType": "table",
          "rawSql": "SELECT toString(z.zone_id) as zone_id, z.zone_name, z.borough, count() as demand FROM default.taxi_events e JOIN default.taxi_zones z ON e.zone_id = z.zone_id WHERE e.event = 'PICKUP' AND e.ts >= (SELECT max(ts) - toIntervalHour(24) FROM default.taxi_events) AND z.zone_id NOT IN (57, 104, 105, 264, 265) GROUP BY z.zone_id, z.zone_name, z.borough ORDER BY demand DESC",
          "refId": "A"
        }
      ],
