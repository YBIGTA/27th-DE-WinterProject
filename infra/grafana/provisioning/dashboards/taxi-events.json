{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Total Events",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
          "queryType": "sql",
          "rawSql": "SELECT count() as total FROM default.taxi_events",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Avg Trip Duration",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 4, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
          "queryType": "sql",
          "rawSql": "SELECT round(avg(duration), 1) as avg_minutes FROM (SELECT trip_id, dateDiff('minute', minIf(ts, event='PICKUP'), maxIf(ts, event='DROPOFF')) as duration FROM default.taxi_events GROUP BY trip_id HAVING duration > 0 AND duration < 180)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 60 }] },
          "unit": "min"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Unique Trips",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 4 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
          "queryType": "sql",
          "rawSql": "SELECT uniq(trip_id) as unique_trips FROM default.taxi_events",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Events Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
          "queryType": "sql",
          "rawSql": "SELECT toStartOfMinute(ts) as time, event, count() as events FROM default.taxi_events GROUP BY time, event ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "pointSize": 5 } },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Top 10 Zones by Demand",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
          "queryType": "sql",
          "rawSql": "SELECT toString(zone_id) as zone, count() as demand FROM default.taxi_events WHERE event = 'PICKUP' GROUP BY zone_id ORDER BY demand DESC LIMIT 10",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Events Per Minute (Real-time)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
          "queryType": "sql",
          "rawSql": "SELECT toStartOfMinute(ts) as time, count() as events_per_min FROM default.taxi_events GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 50 }, "color": { "mode": "fixed", "fixedColor": "yellow" } },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Hourly Event Distribution",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
          "queryType": "sql",
          "rawSql": "SELECT toHour(ts) as hour, event, count() as events FROM default.taxi_events GROUP BY hour, event ORDER BY hour",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Pickup Demand Heatmap",
      "type": "geomap",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
          "queryType": "table",
          "rawSql": "SELECT z.lat as latitude, z.lon as longitude, z.zone_name, z.borough, count() as demand FROM default.taxi_events e JOIN default.taxi_zones z ON e.zone_id = z.zone_id WHERE e.event = 'PICKUP' GROUP BY z.lat, z.lon, z.zone_name, z.borough ORDER BY demand DESC",
          "refId": "A"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 40.730,
          "lon": -73.935,
          "zoom": 10
        },
        "basemap": {
          "type": "default",
          "name": "OpenStreetMap"
        },
        "layers": [
          {
            "type": "heatmap",
            "name": "Pickup Heatmap",
            "config": {
              "weight": { "field": "demand", "fixed": 1, "min": 0, "max": 1 },
              "radius": 20,
              "blur": 15,
              "opacity": 0.6
            },
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            }
          }
        ],
        "tooltip": { "mode": "details" }
      }
    },
    {
      "id": 10,
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(kafka_consumergroup_lag) by (consumergroup, topic)",
          "legendFormat": "{{consumergroup}} - {{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Kafka Messages In/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(kafka_topic_partition_current_offset{topic=\"taxi-event-data\"}[1m])) by (topic)",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 30 }, "color": { "mode": "fixed", "fixedColor": "orange" }, "unit": "ops" },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Recent Events",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "PDEE91DDB90597936" },
          "queryType": "sql",
          "rawSql": "SELECT trip_id, ts, zone_id, event FROM default.taxi_events ORDER BY ts DESC LIMIT 50",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["taxi", "clickhouse", "realtime"],
  "templating": { "list": [] },
  "time": { "from": "2020-01-01T00:00:00.000Z", "to": "2020-01-02T00:00:00.000Z" },
  "timepicker": {},
  "timezone": "Asia/Seoul",
  "title": "NYC Taxi Events",
  "uid": "taxi-events-dashboard"
}
