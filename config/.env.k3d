# =============================================================================
# VERSION 3: K3D (single machine with Kubernetes via k3d)
# config/.env must contain IPs and ports only.
# Non-network settings live in k8s ConfigMaps.
# Copy this file to config/.env before starting:
#   cp config/.env.k3d config/.env
# =============================================================================

# -----------------------------------------------------------------------------
# INSTANCE IP REGISTRY
# -----------------------------------------------------------------------------
GENERATOR_IP=127.0.0.1

CLICKHOUSE_IP=replace-with-aws-clickhouse-ip
LOKI_IP=127.0.0.1
PROMETHEUS_IP=127.0.0.1
GRAFANA_IP=127.0.0.1

# -----------------------------------------------------------------------------
# PORT REGISTRY
# -----------------------------------------------------------------------------
NODEPORT_INGESTOR=30080
NODEPORT_FLINK_UI=30081
NODEPORT_KAFKA_UI=30090

CLICKHOUSE_HTTP_PORT=8123
LOKI_PORT=3100
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
