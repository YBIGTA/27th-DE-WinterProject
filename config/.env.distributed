# =============================================================================
# VERSION 2: DISTRIBUTED (multi-machine)
# Each logical component runs on a separate machine.
# This file is copied as config/.env to EVERY machine in the cluster.
# All machines must have identical config/.env content.
#
# HOW IP UPDATES WORK:
#   Update IPs in the INSTANCE REGISTRY below. Per-component docker-compose
#   files derive their connection strings from these IPs automatically via
#   Docker Compose ${VAR} substitution in their environment: blocks.
#
# EXCEPTION (manual update still needed):
#   - ops/compose/distributed/nginx.distributed.conf: Nginx cannot read env vars in upstream
#     blocks. Edit upstream IPs there manually to match INGESTOR_*_IP.
#
# PARSER NOTE: The generator's C++ env parser does not support ${VAR} expansion.
# All values in this file must be literal. Comments must be on their own lines.
# =============================================================================

# -----------------------------------------------------------------------------
# INSTANCE REGISTRY
# Update IPs here. Component compose files derive connection strings from these.
# -----------------------------------------------------------------------------

# Machine A: Generator + Nginx (co-located)
GENERATOR_IP=127.0.0.1
NGINX_IP=127.0.0.1

# Machine B, C, D: Ingestors (one per machine)
INGESTOR_1_IP=127.0.0.1
INGESTOR_2_IP=127.0.0.1
INGESTOR_3_IP=127.0.0.1

# Machine E, F, G: Kafka brokers (one per machine)
KAFKA_1_IP=127.0.0.1
KAFKA_2_IP=127.0.0.1
KAFKA_3_IP=127.0.0.1

# Machine H: Flink (single node -- JobManager + TaskManager)
FLINK_IP=127.0.0.1

# Machine I: ClickHouse
CLICKHOUSE_IP=127.0.0.1

# S3 Sink Connector: runs on AWS -- no machine entry.

# -----------------------------------------------------------------------------
# GENERATOR
# Consumer: services/generator/generate.cpp (reads INGEST_URL only)
# Generator and Nginx are co-located so INGEST_URL points to localhost.
# -----------------------------------------------------------------------------
INGEST_URL=http://localhost:8080/ingest

# -----------------------------------------------------------------------------
# NGINX + INGESTOR
# NGINX_LB_PORT consumed by ops/compose/distributed/ingestor-nginx.yml via ${NGINX_LB_PORT}.
# INGESTOR_*_PORT consumed by per-ingestor compose files for host port mapping.
# Per-ingestor compose files derive SPRING_KAFKA_BOOTSTRAP_SERVERS from KAFKA_*_IP.
# NGINX NOTE: ops/compose/distributed/nginx.distributed.conf hardcodes upstream IPs.
# When you update INGESTOR_*_IP above, manually edit that file too.
# -----------------------------------------------------------------------------
NGINX_LB_PORT=8080
INGESTOR_PORT=8080
INGESTOR_1_PORT=8080
INGESTOR_2_PORT=8080
INGESTOR_3_PORT=8080

# -----------------------------------------------------------------------------
# KAFKA
# APP_KAFKA_TOPIC consumed by ingestor Spring Boot (via env_file passthrough).
# KAFKA_INTERNAL_PORT / KAFKA_CONTROLLER_PORT are constants referenced by
# per-broker compose files.
# Per-broker compose files derive KAFKA_ADVERTISED_LISTENERS and
# KAFKA_CONTROLLER_QUORUM_VOTERS from KAFKA_*_IP automatically.
# -----------------------------------------------------------------------------
APP_KAFKA_TOPIC=taxi-event-data
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=19093

# -----------------------------------------------------------------------------
# KAFKA UI
# KAFKA_UI_PORT consumed by ops/compose/distributed/kafka-ui.yml via ${KAFKA_UI_PORT}.
# Bootstrap servers are derived in ops/compose/distributed/kafka-ui.yml from KAFKA_*_IP.
# -----------------------------------------------------------------------------
KAFKA_UI_PORT=8090

# -----------------------------------------------------------------------------
# CLICKHOUSE
# Constants consumed by Flink (via env_file) for writing to ClickHouse.
# Flink compose derives the connection host from CLICKHOUSE_IP automatically.
# -----------------------------------------------------------------------------
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=default
CLICKHOUSE_TABLE=taxi_events

# -----------------------------------------------------------------------------
# FLINK (single-node: JobManager + TaskManager)
# Flink compose derives Kafka bootstrap and ClickHouse host from the instance
# registry IPs automatically. These are the remaining constants Flink needs.
# -----------------------------------------------------------------------------
FLINK_KAFKA_TOPIC=taxi-event-data
FLINK_CLICKHOUSE_PORT=9000
FLINK_CLICKHOUSE_DATABASE=default
FLINK_CLICKHOUSE_TABLE=taxi_events
FLINK_JOBMANAGER_PORT=8081
FLINK_TASKMANAGER_SLOTS=2

# -----------------------------------------------------------------------------
# S3 SINK CONNECTOR
# Runs on AWS as Kafka Connect -- not on any machine in this cluster.
# Subscribes to topic: taxi-event-data
# Its bootstrap.servers must be configured in the AWS Kafka Connect worker
# using the Kafka broker IPs from the INSTANCE REGISTRY above (port 9092).
# See infra/connectors/s3-sink-config.template.json for the connector config.
# -----------------------------------------------------------------------------
