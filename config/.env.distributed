# =============================================================================
# VERSION 2: DISTRIBUTED (multi-machine)
# config/.env must contain IPs and ports only.
# Non-network settings are hardcoded in component compose files.
# Copy this file as config/.env to every machine.
# =============================================================================

# -----------------------------------------------------------------------------
# INSTANCE IP REGISTRY
# -----------------------------------------------------------------------------
GENERATOR_IP=127.0.0.1
NGINX_IP=127.0.0.1
INGESTOR_1_IP=127.0.0.1
INGESTOR_2_IP=127.0.0.1
INGESTOR_3_IP=127.0.0.1
KAFKA_1_IP=127.0.0.1
KAFKA_2_IP=127.0.0.1
KAFKA_3_IP=127.0.0.1
FLINK_IP=127.0.0.1
CLICKHOUSE_IP=127.0.0.1

# -----------------------------------------------------------------------------
# PORT REGISTRY
# -----------------------------------------------------------------------------
NGINX_LB_PORT=8080
INGESTOR_PORT=8080
INGESTOR_1_PORT=8080
INGESTOR_2_PORT=8080
INGESTOR_3_PORT=8080

KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=19093
KAFKA_UI_PORT=8090

CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

FLINK_JOBMANAGER_PORT=8081
