# VERSION 2: DISTRIBUTED - Each component on DIFFERENT machines
# Copy this file to ALL machines as .env

# === CUSTOMIZE THESE IPs FOR YOUR NETWORK ===
GENERATOR_MACHINE_IP=127.0.0.1
INGESTOR_1_IP=127.0.0.1
INGESTOR_2_IP=127.0.0.1
INGESTOR_3_IP=127.0.0.1
KAFKA_IP=127.0.0.1

# Generator → Nginx (Nginx on same machine as Generator)
INGEST_URL=http://localhost:8080/ingest

# Ingestor → Kafka (use actual IP)
SPRING_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
APP_KAFKA_TOPIC=taxi-event-data
INGESTOR_PORT=8080

# Kafka Configuration
KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=9093
KAFKA_ADVERTISED_LISTENERS=EXTERNAL://127.0.0.1:9092,INTERNAL://kafka:29092

# Kafka UI
KAFKA_UI_PORT=8090
KAFKA_UI_BOOTSTRAP_SERVERS=localhost:9092

# Nginx Load Balancer (points to actual IPs)
NGINX_LB_PORT=8080
NGINX_UPSTREAM_1=127.0.0.1:8080
NGINX_UPSTREAM_2=127.0.0.1:8080
NGINX_UPSTREAM_3=127.0.0.1:8080

# Individual Ingestor Ports
INGESTOR_1_PORT=8080
INGESTOR_2_PORT=8080
INGESTOR_3_PORT=8080
