# =============================================================================
# VERSION 2: DISTRIBUTED (multi-machine)
# config/.env must contain IPs and ports only.
# Non-network settings are hardcoded in component compose files.
# Copy this file as config/.env to every machine.
# Per-broker ports allow all services to run locally on one machine for testing.
# =============================================================================

# -----------------------------------------------------------------------------
# INSTANCE IP REGISTRY
# -----------------------------------------------------------------------------
GENERATOR_IP=127.0.0.1
NGINX_IP=127.0.0.1

INGESTOR_1_IP=127.0.0.1
INGESTOR_2_IP=127.0.0.1
INGESTOR_3_IP=127.0.0.1

KAFKA_1_IP=127.0.0.1
KAFKA_2_IP=127.0.0.1
KAFKA_3_IP=127.0.0.1

# Flink cluster addressing
# - FLINK_IP: JobManager host IP
# - FLINK_TASKMANAGER_*_IP: each TaskManager host IP (for distributed metrics scraping)
FLINK_IP=127.0.0.1
FLINK_TASKMANAGER_1_IP=127.0.0.1
FLINK_TASKMANAGER_2_IP=127.0.0.1
FLINK_TASKMANAGER_3_IP=127.0.0.1

CLICKHOUSE_IP=127.0.0.1

LOKI_IP=127.0.0.1
PROMETHEUS_IP=127.0.0.1
GRAFANA_IP=127.0.0.1

# -----------------------------------------------------------------------------
# PORT REGISTRY
# -----------------------------------------------------------------------------
NGINX_LB_PORT=8080
NGINX_EXPORTER_PORT=9113
NGINX_PROMTAIL_PORT=9085
INGESTOR_PORT=8080

INGESTOR_1_PORT=8081
INGESTOR_2_PORT=8082
INGESTOR_3_PORT=8083

# Kafka — per-broker ports (distinct so all 3 brokers run on one machine)
KAFKA_1_EXTERNAL_PORT=9092
KAFKA_2_EXTERNAL_PORT=9094
KAFKA_3_EXTERNAL_PORT=9096

KAFKA_1_INTERNAL_PORT=29092
KAFKA_2_INTERNAL_PORT=29094
KAFKA_3_INTERNAL_PORT=29096

KAFKA_1_CONTROLLER_PORT=19093
KAFKA_2_CONTROLLER_PORT=19094
KAFKA_3_CONTROLLER_PORT=19095

KAFKA_UI_PORT=8090

CLICKHOUSE_HTTP_PORT=8123

CLICKHOUSE_NATIVE_PORT=9000

FLINK_JOBMANAGER_PORT=8084
FLINK_JOBMANAGER_RPC_PORT=6129

FLINK_TASKMANAGER_1_RPC_PORT=6122
FLINK_TASKMANAGER_2_RPC_PORT=6123
FLINK_TASKMANAGER_3_RPC_PORT=6124

LOKI_PORT=3100
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
