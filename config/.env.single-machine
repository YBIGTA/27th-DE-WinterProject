# VERSION 1: SINGLE MACHINE - All components on ONE device

# Generator → Nginx
INGEST_URL=http://localhost:8080/ingest

# Ingestor → Kafka (Docker internal networking)
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
APP_KAFKA_TOPIC=taxi-event-data
INGESTOR_PORT=8080

# Kafka Configuration
KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=9093
KAFKA_ADVERTISED_LISTENERS=EXTERNAL://localhost:9092,INTERNAL://kafka:29092

# Kafka UI
KAFKA_UI_PORT=8090
KAFKA_UI_BOOTSTRAP_SERVERS=kafka:29092

# Ingestor Cluster (external ports on host machine)
INGESTOR_1_PORT=8081
INGESTOR_2_PORT=8082
INGESTOR_3_PORT=8083

# Nginx Load Balancer
NGINX_LB_PORT=8080
NGINX_UPSTREAM_1=ingestor-1:8080
NGINX_UPSTREAM_2=ingestor-2:8080
NGINX_UPSTREAM_3=ingestor-3:8080
