# =============================================================================
# VERSION 1: SINGLE MACHINE
# All components run on one machine via Docker. Uses Docker internal DNS names.
# Copy this file to config/.env before starting services:
#   cp config/.env.single-machine config/.env
# =============================================================================

# -----------------------------------------------------------------------------
# GENERATOR
# Consumer: generator/generate.cpp (reads INGEST_URL only)
# -----------------------------------------------------------------------------
INGEST_URL=http://localhost:8080/ingest

# -----------------------------------------------------------------------------
# NGINX + INGESTOR CLUSTER
# Local docker-compose.yml hardcodes upstream hostnames in environment: block.
# These vars are documented here for topology clarity and parity with
# .env.distributed. NGINX_LB_PORT is consumed by the distributed nginx compose.
# -----------------------------------------------------------------------------
NGINX_LB_PORT=8080
INGESTOR_PORT=8080
INGESTOR_1_PORT=8081
INGESTOR_2_PORT=8082
INGESTOR_3_PORT=8083
NGINX_UPSTREAM_1=ingestor-1:8080
NGINX_UPSTREAM_2=ingestor-2:8080
NGINX_UPSTREAM_3=ingestor-3:8080

# -----------------------------------------------------------------------------
# KAFKA (3-broker KRaft cluster)
# Local docker-compose.yml hardcodes per-broker config in environment: blocks.
# These vars document the actual topology and are forward-looking for when
# compose files are updated to use ${VAR} substitution.
# Internal port (Docker): 29092 on all brokers
# External ports (host): 9092 (broker-1), 9094 (broker-2), 9096 (broker-3)
# -----------------------------------------------------------------------------
APP_KAFKA_TOPIC=taxi-event-data
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka-1:29092,kafka-2:29092,kafka-3:29092
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka-1:29092,kafka-2:29092,kafka-3:29092
KAFKA_BOOTSTRAP_SERVERS_EXTERNAL=localhost:9092,localhost:9094,localhost:9096
KAFKA_1_EXTERNAL_PORT=9092
KAFKA_2_EXTERNAL_PORT=9094
KAFKA_3_EXTERNAL_PORT=9096
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=19093

# -----------------------------------------------------------------------------
# KAFKA UI
# KAFKA_UI_PORT is consumed via ${KAFKA_UI_PORT:-8090} in compose.
# -----------------------------------------------------------------------------
KAFKA_UI_PORT=8090
KAFKA_UI_BOOTSTRAP_SERVERS=kafka-1:29092,kafka-2:29092,kafka-3:29092

# -----------------------------------------------------------------------------
# CLICKHOUSE
# ClickHouse compose (infra/clickhouse/) does not read .env -- self-contained.
# These vars are for Flink and any other consumer that needs to reach it.
# Docker hostname: clickhouse | Host: localhost
# -----------------------------------------------------------------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=default
CLICKHOUSE_TABLE=taxi_events

# -----------------------------------------------------------------------------
# FLINK (single-node: JobManager + TaskManager)
# Flink compose (infra/flink/) is not yet configured. These vars define what
# the future compose will need. Flink consumes from Kafka, writes to ClickHouse.
# -----------------------------------------------------------------------------
FLINK_KAFKA_BOOTSTRAP_SERVERS=kafka-1:29092,kafka-2:29092,kafka-3:29092
FLINK_KAFKA_TOPIC=taxi-event-data
FLINK_CLICKHOUSE_HOST=clickhouse
FLINK_CLICKHOUSE_PORT=9000
FLINK_CLICKHOUSE_DATABASE=default
FLINK_CLICKHOUSE_TABLE=taxi_events
FLINK_JOBMANAGER_PORT=8081
FLINK_TASKMANAGER_SLOTS=2

# -----------------------------------------------------------------------------
# S3 SINK CONNECTOR
# Runs on AWS as Kafka Connect -- not locally. No variables needed here.
# Subscribes to topic: taxi-event-data
# Its bootstrap.servers is configured in the AWS Kafka Connect worker.
# See connectors/s3-sink-config.template.json for the connector config.
# -----------------------------------------------------------------------------
